{
  "name": "agent-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local tabbed HTML board the Cursor agent can drive over MCP",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js --daemon",
    "mcp": "node dist/index.js",
    "dev": "tsx watch src/index.ts --daemon",
    "stop": "node dist/index.js --stop",
    "test": "tsx --test src/htmlEdit.test.ts src/store.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "express": "^4.21.2",
    "playwright-core": "^1.63.0",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
