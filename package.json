{
  "name": "agent-board",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local tabbed HTML board the Cursor agent can drive over MCP",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js --daemon",
    "mcp": "node dist/index.js",
    "dev": "tsx watch src/index.ts --daemon",
    "stop": "node dist/index.js --stop",
    "desktop": "cargo run --manifest-path desktop/Cargo.toml",
    "desktop:build": "tauri build",
    "desktop:install": "node desktop/install.mjs",
    "test": "tsx --test src/htmlEdit.test.ts src/store.test.ts src/pageSearch.test.ts src/boardExport.test.ts src/templates.test.ts src/embed.test.ts src/frameCheck.test.ts src/agent/textDiff.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@anthropic-ai/sdk": "^0.130.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dompurify": "^3.4.16",
    "express": "^4.21.2",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
